{
  "name": "freelance-budget-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "uvicorn freelance_budget.api.app:app --reload --app-dir ../src --port 8000",
    "dev:all": "concurrently -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.0.1",
    "typescript": "^5.5.3",
    "vite": "^5.4.1"
  }
}
