# Credenziali app Fatture in Cloud.
# Copiare in .env (non versionato) e compilare.

FIC_CLIENT_ID=
FIC_CLIENT_SECRET=
FIC_REDIRECT_URI=http://localhost:8000/auth/fic/callback

# Percorso dove salvare il token OAuth (default: .fic_token.json in root).
# FIC_TOKEN_PATH=.fic_token.json

# Token di accesso alla dashboard: link https://<host>/?t=<token>. Vuoto = nessun controllo.
SHARE_TOKEN=
